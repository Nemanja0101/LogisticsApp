{
  "info": {
    "name": "LogisticsApp API",
    "description": "Auth + Shipment Order + Freight endpoints for the LogisticsApp API.\n\nNotes:\n- Auth is cookie-based JWT (Set-Cookie: jwt / refreshToken). Postman's cookie jar handles this automatically as long as requests stay on {{baseUrl}} — just run \"Login\" once per session.\n- There is currently no Location API, so `startLocationId` / `endLocationId` collection variables must be filled in manually with real UUIDs from the `locations` table before running the Shipment Orders / Freights folders.\n- Known bugs at time of writing (2026-08-26): POST /shipment-orders does not persist (id/createdAt come back null and the row is never saved), and DELETE /shipment-orders/{id} does not persist the CANCELLED status. See ShipmentOrderService.createShipmentOrder and .deleteShipmentOrder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "testEmail", "value": "apitest@example.com" },
    { "key": "testPassword", "value": "Test1234!" },
    { "key": "startLocationId", "value": "" },
    { "key": "endLocationId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "freightId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"firstName\": \"Api\",\n  \"lastName\": \"Tester\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Sets the jwt / refreshToken cookies used by every authenticated request below."
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Shipment Orders",
      "item": [
        {
          "name": "Get All Shipment Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders"]
            }
          }
        },
        {
          "name": "Get Shipment Order By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Create Shipment Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.collectionVariables.set('orderId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startLocationId\": \"{{startLocationId}}\",\n  \"endLocationId\": \"{{endLocationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders"]
            }
          }
        },
        {
          "name": "Update Shipment Order (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startLocationId\": \"{{startLocationId}}\",\n  \"endLocationId\": \"{{endLocationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Patch Shipment Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startLocationId\": \"{{startLocationId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Patch Shipment Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}", "status"]
            },
            "description": "status is one of: PENDING, CONFIRMED, ASSIGNED, IN_TRANSIT, PARTIALLY_DELIVERED, DELIVERED, CANCELLED, ON_HOLD"
          }
        },
        {
          "name": "Delete Shipment Order",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Freights",
      "item": [
        {
          "name": "Create Freight",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.collectionVariables.set('freightId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pallet of electronics\",\n  \"description\": \"Fragile\",\n  \"weightKg\": 250.5,\n  \"lengthCm\": 120,\n  \"widthCm\": 80,\n  \"heightCm\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}/freights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}", "freights"]
            }
          }
        },
        {
          "name": "Get All Freights On Order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}/freights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}", "freights"]
            }
          }
        },
        {
          "name": "Get Single Freight",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipment-orders/{{orderId}}/freights/{{freightId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "shipment-orders", "{{orderId}}", "freights", "{{freightId}}"]
            }
          }
        }
      ]
    }
  ]
}
